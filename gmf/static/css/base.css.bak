/* =========================================================
   GMFitness - estilos base (todas las páginas)
   Paleta tomada del repositorio de diseño GMFitness-diseno
   ========================================================= */

:root {
  --azul-secundario: #1e223e;
  --azul-oscuro: #0f111f;
  --azul-fondo-iconos: #262b4e;
  --naranja: #fe6c05;
  --borde-naranja: #803605;
  --blanco-primario: #ffffff;
  --gris-inactivo: #9699ae;
  --negro: #000000;
  --gris-bordes: #505578;

  /* =========================================
     1. NARANJA
     ========================================= */
  --naranja-100: #ffceac;
  --naranja-200: #ffb682;
  --naranja-300: #fe9d58;
  --naranja-400: #fe852f;
  --naranja-500: #fe6c05;
  --naranja-600: #d45a04;
  --naranja-700: #a94803;
  --naranja-800: #7f3603;
  --naranja-900: #552402;

  /* =========================================
     2. AZUL
     ========================================= */
  --azul-100: #b9bbc9;
  --azul-200: #9699ae;
  --azul-300: #737793;
  --azul-400: #505578;
  --azul-500: #2d335d;
  --azul-600: #262b4e;
  --azul-700: #1e223e;
  --azul-800: #171a2f;
  --azul-900: #0f111f;

  /* =========================================
     3. AZUL OSCURO
     ========================================= */
  --azul-oscuro-100: #abacb4;
  --azul-oscuro-200: #81838f;
  --azul-oscuro-300: #575a69;
  --azul-oscuro-400: #2d3044;
  --azul-oscuro-500: #03071e;
  --azul-oscuro-600: #030619;
  --azul-oscuro-700: #020514;
  --azul-oscuro-800: #02040f;
  --azul-oscuro-900: #01020a;

  /* =========================================
     4. NEGRO / GRIS
     ========================================= */
  --negro-100: #b2b2b2;
  --negro-200: #8c8c8c;
  --negro-300: #666666;
  --negro-400: #3f3f3f;
  --negro-500: #191919;
  --negro-600: #151515;
  --negro-700: #111111;
  --negro-800: #0d0d0d;
  --negro-900: #080808;

  /* =========================================
     5. BLANCO / GRIS CLARO
     ========================================= */
  --blanco-500: #ffffff;
  --blanco-600: #d5d5d5;
  --blanco-700: #aaaaaa;
  --blanco-800: #808080;
  --blanco-900: #555555;
}

/* 
--------------------------------
            General
--------------------------------
*/
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px; /* el encabezado es fijo */
}

body {
  margin: 0;
  min-height: 100vh;
  background-color: var(--azul-oscuro);
  color: var(--blanco-primario);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.5;
}

a {
  color: var(--naranja);
}

a:hover {
  color: var(--naranja-300);
}

.contenedor {
  width: min(100% - 2rem, 1180px);
  margin-inline: auto;
}

.texto-naranja {
  color: var(--naranja);
}

/* 
--------------------------------
            Botones
--------------------------------
*/
.boton-primario,
.boton-secundario {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.55rem 1.25rem;
  border-radius: 8px;
  border: 2px solid transparent;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}

.boton-primario {
  background-color: var(--naranja);
  border-color: var(--naranja);
  color: var(--negro);
}

.boton-primario:hover {
  background-color: var(--borde-naranja);
  border-color: var(--borde-naranja);
  color: var(--blanco-primario);
}

.boton-secundario {
  background-color: transparent;
  border-color: var(--gris-inactivo);
  color: var(--blanco-primario);
}

.boton-secundario:hover {
  background-color: var(--azul-fondo-iconos);
  border-color: var(--blanco-primario);
  color: var(--blanco-primario);
}

.boton-primario:disabled,
.boton-secundario:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.boton-grande {
  padding: 0.8rem 1.6rem;
  font-size: 1.05rem;
}

.boton-ancho {
  width: 100%;
}

:focus-visible {
  outline: 3px solid var(--naranja-300);
  outline-offset: 2px;
}

/* 
--------------------------------
            Encabezado
--------------------------------
*/
header {
  position: fixed;
  inset: 0 0 auto 0;
  height: 70px;
  background-color: var(--azul-secundario);
  border-bottom: 1px solid var(--azul-fondo-iconos);
  z-index: 1000;
}

header nav {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.logo {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--blanco-primario);
  text-decoration: none;
  letter-spacing: 0.02em;
}

.logo span {
  color: var(--naranja);
}

.logo:hover {
  color: var(--blanco-primario);
}

#menu-secciones {
  list-style: none;
  display: flex;
  gap: 2rem;
  margin: 0 auto;
  padding: 0;
}

#menu-secciones a {
  color: var(--gris-inactivo);
  text-decoration: none;
  font-weight: 600;
}

#menu-secciones a:hover {
  color: var(--blanco-primario);
}

#acciones-cuenta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-left: auto;
}

#menu-secciones + #acciones-cuenta {
  margin-left: 0;
}

#saludo-usuario {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--blanco-primario);
  font-weight: 600;
}

.usuario-bola {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background-color: var(--naranja);
  color: var(--negro);
  font-weight: 800;
  font-size: 0.9rem;
}

#form-salir {
  margin: 0;
}

#btn-menu {
  display: none;
  background: none;
  border: 0;
  color: var(--blanco-primario);
  font-size: 1.4rem;
  cursor: pointer;
}

/* 
--------------------------------
            Mensajes (django.contrib.messages)
--------------------------------
*/
#mensajes {
  position: fixed;
  top: 85px;
  right: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  z-index: 1100;
  width: min(100% - 2rem, 380px);
}

.mensaje {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  padding: 0.85rem 1rem;
  border-radius: 10px;
  background-color: var(--azul-secundario);
  border: 1px solid var(--azul-fondo-iconos);
  border-left: 4px solid var(--naranja);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.mensaje.oculto {
  opacity: 0;
  transform: translateX(20px);
}

.mensaje p {
  margin: 0;
  flex: 1;
}

.mensaje-info {
  border-left-color: var(--gris-inactivo);
}

.mensaje-error {
  border-left-color: #e5484d;
}

.mensaje-cerrar {
  background: none;
  border: 0;
  color: var(--gris-inactivo);
  font-size: 1.2rem;
  line-height: 1;
  cursor: pointer;
}

/* 
--------------------------------
            Responsive
--------------------------------
*/
@media (max-width: 860px) {
  #btn-menu {
    display: block;
    order: 3;
  }

  #menu-secciones {
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 0;
    background-color: var(--azul-secundario);
    border-bottom: 1px solid var(--azul-fondo-iconos);
    display: none;
  }

  #menu-secciones.abierto {
    display: flex;
  }

  #menu-secciones a {
    display: block;
    padding: 0.9rem 1.5rem;
  }

  #acciones-cuenta {
    margin-left: auto;
  }

  #menu-secciones + #acciones-cuenta {
    margin-left: auto;
  }

  #saludo-usuario span:not(.usuario-bola) {
    display: none;
  }
}

@media (max-width: 480px) {
  header nav {
    gap: 0.6rem;
  }

  .logo {
    font-size: 1.3rem;
  }

  #acciones-cuenta .boton-primario,
  #acciones-cuenta .boton-secundario {
    padding: 0.45rem 0.7rem;
    font-size: 0.85rem;
  }
}
