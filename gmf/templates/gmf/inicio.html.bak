{% extends "gmf/base.html" %}

{% block titulo %}Inicio | GMFitness{% endblock %}

{% block contenido %}
  <section class="hero">
    <h1>Entrena fuerte. <span>Vive mejor.</span></h1>
    <p>Planes de entrenamiento, clases grupales y acompañamiento para que alcances tus metas.</p>
    <a class="boton" href="#">Ver planes</a>
  </section>

  <section class="beneficios">
    <article class="tarjeta">
      <h3>Entrenadores</h3>
      <p>Rutinas guiadas y adaptadas a tu nivel.</p>
    </article>
    <article class="tarjeta">
      <h3>Clases grupales</h3>
      <p>Funcional, spinning y más, todos los días.</p>
    </article>
    <article class="tarjeta">
      <h3>Horario amplio</h3>
      <p>Abierto desde temprano hasta la noche.</p>
    </article>
  </section>
{% endblock %}
