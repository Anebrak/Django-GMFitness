{% load static gmf_extras %}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block titulo %}GMFitness{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{% static 'css/base.css' %}">
    {# Cada página agrega su propia hoja de estilos #}
    {% block estilos %}{% endblock %}
</head>

<body>
    <header>
        <nav class="contenedor" aria-label="Principal">
            <a class="logo" href="{% url 'inicio' %}">GM<span>Fitness</span></a>

            {# Enlaces a las secciones: solo los muestra la página de inicio #}
            {% block menu_secciones %}{% endblock %}

            <div id="acciones-cuenta">
                {% if user.is_authenticated %}
                    {% if user.rol == "ADMINISTRADOR" %}
                        <a class="boton-secundario" id="btn-ir-panel" href="{% url 'panel' %}">
                            <i class="fa-solid fa-gauge"></i><span class="texto-boton"> Panel</span>
                        </a>
                    {% endif %}
                    <div id="saludo-usuario">
                        <span class="usuario-bola" aria-hidden="true">{{ user|iniciales }}</span>
                        <span>{{ user.first_name|default:user.email }}</span>
                    </div>
                    <form id="form-salir" method="post" action="{% url 'salir' %}">
                        {% csrf_token %}
                        <button type="submit" class="boton-secundario">
                            <i class="fa-solid fa-right-from-bracket"></i> Salir
                        </button>
                    </form>
                {% else %}
                    <a class="boton-secundario" href="{% url 'ingresar' %}">Ingresar</a>
                    <a class="boton-primario" href="{% url 'registro' %}">Registrarse</a>
                {% endif %}
            </div>

            {% block boton_menu %}{% endblock %}
        </nav>
    </header>

    {% if messages %}
        <div id="mensajes" role="status">
            {% for mensaje in messages %}
                <div class="mensaje{% if mensaje.tags %} mensaje-{{ mensaje.tags }}{% endif %}">
                    <p>{{ mensaje }}</p>
                    <button type="button" class="mensaje-cerrar" aria-label="Cerrar">&times;</button>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <main>
        {% block contenido %}{% endblock %}
    </main>

    {% block pie %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{% static 'js/base.js' %}"></script>
    {% block scripts %}{% endblock %}
</body>

</html>
